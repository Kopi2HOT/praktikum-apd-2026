# Data login
nama_saya = "rahmat"
nim_saya = "29"

print("=" * 40)
print("     Verifikasi Identitas      ")
print("=" * 40)

nama_input = input("Masukkan Nama Anda: ")
nim_input = input("Masukkan NIM Anda: ")

# Validasi login menggunakan percabangan if-else
if nama_input != nama_saya or nim_input != nim_saya:
    print()
    print("Login Gagal! Nama atau NIM tidak sesuai.")
else:
    print()
    print(f"Login Berhasil! Selamat datang, {nama_input}.")

    # Memilih jenis BBM
    print("=" * 40)
    print("     PILIHAN JENIS BBM       ")
    print("=" * 40)
    print("1. Pertalite         : Rp 10.000/liter")
    print("2. Pertamax          : Rp 12.500/liter")
    print("3. Pertamax Turbo    : Rp 15.000/liter")
    print("=" * 40)

    pilihan = input("Masukkan pilihan jenis BBM (1-3): ")

    # Validasi pilihan jenis BBM
    if pilihan == "1" or pilihan == "2" or pilihan == "3":
        if pilihan == "1":
            harga_per_liter = 10000
            jenis_bbm = "Pertalite"
        elif pilihan == "2":
            harga_per_liter = 12500
            jenis_bbm = "Pertamax"
        elif pilihan == "3":
            harga_per_liter = 15000
            jenis_bbm = "Pertamax Turbo"

        jumlah_liter = float(input("Masukkan jumlah liter : "))
        total_harga = jumlah_liter * harga_per_liter

        if jumlah_liter >= 10:
            persen_diskon = 0.10
        elif jumlah_liter >= 5:
            persen_diskon = 0.05
        else:
            persen_diskon = 0.0

        diskon = total_harga * persen_diskon

        # Validasi keanggotaan member
        member = input("Apakah Anda member? (ya/tidak): ")
        if member == "ya":
            persen_diskon_member = 0.02
            status = "Member"
        else:
            persen_diskon_member = 0.0
            status = "Non-Member"

        diskon_member = total_harga * persen_diskon_member

        # Menghitung total diskon dan total bayar
        total_diskon = diskon + diskon_member
        total_bayar = total_harga - total_diskon

        # Tampilan Output
        print("=" * 40)
        print("     Rincian Pembayaran       ")           
        print("=" * 40)
        print(f"Nama Pelanggan : {nama_input}")
        print(f"NIM Pelanggan  : {nim_input}")
        print(f"Status Keanggotaan : {status}")
        print("-" * 40)
        print(f"Jenis BBM      : {jenis_bbm} | ")
        print(f"Harga per Liter: Rp {int(harga_per_liter)}")
        print(f"Jumlah Liter   : {jumlah_liter} liter ")
        print("-" * 40)
        print(f"Total Harga    : Rp {int(total_harga)}")
        print(f"Diskon liter  : Rp {int(diskon)} ")
        print(f"Diskon Member  : Rp {int(diskon_member)}")
        print("=" * 40)
        print(f"Total Bayar     : Rp {int(total_bayar)} ")
        print("=" * 40)
    else:
        print()
        print("Pilihan jenis BBM tidak valid. Silakan pilih antara 1, 2, atau 3.")